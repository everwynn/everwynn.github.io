---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import VisitCounter from '../components/VisitCounter.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '所有站点的总站，学习与数据的控制台。' } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const href = (path: string) => `${base}${path.replace(/^\//, '')}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const pageTitle = title === 'EverWynn Station' ? title : `${title} · EverWynn Station`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="theme-color" content="#f7f7f5" />
    <!-- 主题初始化：必须在首帧前决定，避免闪烁。
         三态：light | dark | system（默认 system），只改 class 与 color-scheme，不做颜色渐变。
         apply() 挂到 window.__stationTheme，供 ThemeToggle 在圆形揭示时调用。 -->
    <script is:inline>
      (function () {
        var KEY = 'station:theme';
        var MODES = ['light', 'dark', 'system'];
        var root = document.documentElement;
        var media = window.matchMedia('(prefers-color-scheme: dark)');

        function readMode() {
          try {
            var saved = localStorage.getItem(KEY);
            if (MODES.indexOf(saved) !== -1) return saved;
          } catch (err) {
            /* 隐私模式下 localStorage 不可读，按跟随系统处理 */
          }
          return 'system';
        }

        function apply(mode, persist) {
          var resolved = mode === 'system' ? (media.matches ? 'dark' : 'light') : mode;
          root.classList.toggle('dark', resolved === 'dark');
          root.setAttribute('data-theme-mode', mode);
          root.style.colorScheme = resolved;
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', resolved === 'dark' ? '#121211' : '#f7f7f5');
          if (persist) {
            try {
              localStorage.setItem(KEY, mode);
            } catch (err) {
              /* 写不进去就只影响本次会话 */
            }
          }
        }

        window.__stationTheme = { apply: apply, readMode: readMode };
        apply(readMode(), false);

        // 选择“跟随系统”时，系统主题变化要跟着变
        media.addEventListener('change', function () {
          if (readMode() === 'system') apply('system', false);
        });
      })();
    </script>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-3 focus:top-3 focus:z-50 focus:rounded focus:bg-ink focus:px-3 focus:py-2 focus:text-canvas"
    >
      跳到主要内容
    </a>
    <header>
      <div class="mx-auto flex max-w-content items-center justify-between gap-4 px-4 py-4 sm:px-6">
        <a href={href('/')} class="group flex items-baseline gap-2">
          <span class="text-base font-semibold tracking-tight">EverWynn Station</span>
          <span class="hidden font-mono text-[11px] uppercase tracking-[0.18em] text-muted sm:inline">维恩总站</span>
        </a>
        <nav class="flex items-center gap-4" aria-label="主导航">
          <a href={href('/stats/')} class="text-sm text-muted transition-colors hover:text-ink">访问量</a>
          <a href={href('/about/')} class="text-sm text-muted transition-colors hover:text-ink">关于</a>
          <ThemeToggle />
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="border-t border-line">
      <div class="mx-auto flex max-w-content flex-col gap-2 px-4 py-6 text-xs text-muted sm:flex-row sm:items-center sm:justify-between sm:px-6">
        <p>EverWynn Station · 数据以各站点为准</p>
        <a
          href="https://github.com/EverWynn"
          class="transition-colors hover:text-ink"
          target="_blank"
          rel="noopener noreferrer"
        >
          GitHub
        </a>
      </div>
      <div class="mx-auto max-w-content px-4 pb-6 text-xs text-muted sm:px-6">
        <VisitCounter site="station" />
      </div>
    </footer>
  </body>
</html>
