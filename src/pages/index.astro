---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteCard from '../components/SiteCard.astro';
import CategoryNav from '../components/CategoryNav.astro';
import {
  getSites,
  getUpdatedAt,
  categoryCounts,
  summarize,
} from '../lib/sites';
import { formatAbsolute, formatRelative } from '../lib/format';

const sites = getSites();
const counts = summarize(sites);
const categories = categoryCounts(sites);
const updatedAt = getUpdatedAt();

// 概览条：数量 + 状态分布，0 值不占位；分类语义交给筛选与卡片标签。
type OverviewItem =
  | { kind: 'total'; value: number; label: string }
  | { kind: 'status'; value: number; label: string; dot: string };

const statusItems: OverviewItem[] = (
  [
    // label 自带量词，与 total 的「个站点」保持同一读法（7 个站点 · 7 个正常）
    ['ok', '个正常', 'bg-ok'],
    ['warn', '个需关注', 'bg-warn'],
    ['error', '个异常', 'bg-danger'],
    ['unknown', '个未知', 'bg-muted/60'],
  ] as const
)
  .filter(([key]) => counts[key] > 0)
  .map(([key, label, dot]) => ({ kind: 'status' as const, value: counts[key], label, dot }));

const overview: OverviewItem[] = [
  { kind: 'total', value: sites.length, label: '个站点' },
  ...statusItems,
];
---

<BaseLayout title="EverWynn Station">
  <section class="mx-auto max-w-content px-4 pb-10 pt-12 sm:px-6 sm:pt-16">
    <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-muted">Station Index</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-[32px]">所有站点，一处入口</h1>
    <p class="mt-4 max-w-[60ch] text-balance text-[15px] leading-relaxed text-muted">
      {sites.length} 个站点的入口与运行状态，每天自动更新两次。
    </p>

    <ul class="mt-8 flex min-h-11 flex-wrap items-center gap-y-1.5 text-sm">
      {overview.map((item, index) => (
        <li class="flex items-center gap-2.5">
          {index > 0 && <span class="text-muted/50" aria-hidden="true">·</span>}
          {item.kind === 'status' ? (
            <span class="flex items-center gap-1.5">
              <span class:list={['h-1.5 w-1.5 shrink-0 rounded-full', item.dot]} aria-hidden="true" />
              <span class="flex items-baseline gap-1">
                <span class="font-mono font-medium leading-none">{item.value}</span>
                <span class="text-muted">{item.label}</span>
              </span>
            </span>
          ) : (
            <span class="flex items-baseline gap-1.5">
              <span class="font-mono text-[15px] font-medium leading-none">{item.value}</span>
              <span class="text-muted">{item.label}</span>
            </span>
          )}
        </li>
      ))}
      <li class="flex items-center gap-2.5">
        <span class="text-muted/50" aria-hidden="true">·</span>
        <time datetime={updatedAt} title={formatAbsolute(updatedAt)} class="text-muted">
          {formatRelative(updatedAt)}更新
        </time>
      </li>
    </ul>
  </section>

  <!-- 筛选行：桌面吸顶保持列表可筛，移动端两行高，吸顶会吃掉过多视口，不吸顶 -->
  <div class="border-b border-line bg-canvas sm:sticky sm:top-0 sm:z-10">
    <div class="mx-auto flex max-w-content flex-col gap-3 px-4 py-3 sm:flex-row sm:items-center sm:justify-between sm:px-6">
      <CategoryNav categories={categories} total={sites.length} />
      <label class="relative block sm:w-60">
        <span class="sr-only">搜索站点</span>
        <svg
          class="pointer-events-none absolute left-2.5 top-1/2 h-3.5 w-3.5 -translate-y-1/2 text-muted"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="6.5"></circle>
          <path stroke-linecap="round" d="m16 16 4 4"></path>
        </svg>
        <input
          id="site-search"
          type="search"
          placeholder="搜索站点、技术…"
          autocomplete="off"
          class="h-8 w-full rounded-full border border-line bg-surface pl-8 pr-3 text-[13px] text-ink placeholder:text-muted/70 focus:border-ink/40"
        />
      </label>
    </div>
  </div>

  <div class="mx-auto max-w-content px-4 py-8 sm:px-6">
    <p class="min-h-4 text-xs text-muted" data-result-count aria-live="polite"></p>

    <div class="mt-3 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {sites.map((site) => <SiteCard site={site} />)}
    </div>

    <p class="py-16 text-center text-sm text-muted" data-empty hidden>
      没有匹配的站点，换个关键词试试。
    </p>
  </div>

  <script>
    const FILTER_KEY = 'station:filter';
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-site-card]'));
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const searchInput = document.getElementById('site-search') as HTMLInputElement | null;
    const countEl = document.querySelector<HTMLElement>('[data-result-count]');
    const emptyEl = document.querySelector<HTMLElement>('[data-empty]');

    let category = 'all';
    let query = '';

    const readFilter = () => {
      try {
        return localStorage.getItem(FILTER_KEY) ?? 'all';
      } catch {
        return 'all';
      }
    };

    const writeFilter = (value: string) => {
      try {
        localStorage.setItem(FILTER_KEY, value);
      } catch {
        // 隐私模式下忽略写入失败
      }
    };

    const apply = () => {
      let visible = 0;
      for (const card of cards) {
        const matchCategory = category === 'all' || card.dataset.category === category;
        const matchQuery = !query || (card.dataset.search ?? '').includes(query);
        const show = matchCategory && matchQuery;
        card.hidden = !show;
        if (show) visible += 1;
      }

      for (const button of buttons) {
        button.setAttribute('aria-pressed', String(button.dataset.filter === category));
      }

      if (countEl) {
        countEl.textContent =
          visible === cards.length ? '' : `显示 ${visible} / ${cards.length} 个站点`;
      }
      if (emptyEl) emptyEl.hidden = visible !== 0;
    };

    const stored = readFilter();
    category = buttons.some((button) => button.dataset.filter === stored) ? stored : 'all';
    if (searchInput) {
      searchInput.addEventListener('input', () => {
        query = searchInput.value.trim().toLowerCase();
        apply();
      });
    }

    for (const button of buttons) {
      button.addEventListener('click', () => {
        category = button.dataset.filter ?? 'all';
        writeFilter(category);
        apply();
      });
    }

    apply();
  </script>
</BaseLayout>
